{
  "name": "reto-02-registro-contratos",
  "version": "1.0.0",
  "description": "Agente conversacional para el registro de contratos vigentes desde un buzón único — Reto técnico 02 Periferia IT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "demo": "tsx demo.ts",
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && cd web && npm install && npm run build",
    "build:server": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "web:dev": "cd web && npm run dev"
  },
  "dependencies": {
    "@google/genai": "^1.9.0",
    "@hono/node-server": "^1.13.7",
    "hono": "^4.6.14",
    "papaparse": "^5.4.1",
    "pdf-lib": "^1.17.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/papaparse": "^5.3.15",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
