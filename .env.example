# ─────────────────────────────────────────────────────────────
# Variables de entorno del backend — Reto 02
# Copia este archivo a .env y rellena los valores. NUNCA subas .env a git.
# ─────────────────────────────────────────────────────────────

# Proveedor LLM: clave de Google Gemini (se lee solo en el backend)
GOOGLE_API_KEY=

# Modelo a usar
GEMINI_MODEL=gemini-2.5-flash

# Puerto del servidor HTTP
PORT=8000

# Topes de costo/seguridad del ciclo del agente
MAX_ITERACIONES=25
MAX_TOKENS_SESION=120000
